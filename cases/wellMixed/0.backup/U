// OpenFOAM Foundation 13 | oxyControlFoam | SI units
// Read the numbered sections and comments before changing physical settings.
FoamFile
{
    version 2.0; format ascii;
    class volVectorField;
    object U;
}

// 1. Dimensions and initial value. Oxygen: mol/m3; p: kinematic pressure.
dimensions [0 1 -1 0 0 0 0];
internalField uniform (0 0 0);

// 2. Closed, stationary tank: no fluid or oxygen flux through the walls.
boundaryField
{
    sideWall { type fixedValue; value uniform (0 0 0); }
    bottom { type fixedValue; value uniform (0 0 0); }
    top { type fixedValue; value uniform (0 0 0); }
}
