// OpenFOAM Foundation 13 | oxyControlFoam | SI units
// Read the numbered sections and comments before changing physical settings.
FoamFile
{
    version 2.0; format ascii;
    class dictionary;
    object fvSolution;
}

// 1. Tight oxygen tolerance makes the molar budget interpretable.
solvers
{
    oxygen { solver PBiCGStab; preconditioner DILU; tolerance 1e-12; relTol 0; }
    oxygenFinal { $oxygen; relTol 0; }
    p { solver PCG; preconditioner DIC; tolerance 1e-8; relTol 0.01; }
    pFinal { $p; relTol 0; }
    "(U|UFinal|flm|flmFinal|fmm|fmmFinal)"
    { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-9; relTol 0; }
}
// 2. Transient pressure/velocity coupling on a mildly non-orthogonal O-grid.
PIMPLE
{
    nOuterCorrectors 2; nCorrectors 3; nNonOrthogonalCorrectors 2;
    momentumPredictor true; pRefCell 0; pRefValue 0;
}
