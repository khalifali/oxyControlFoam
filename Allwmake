#!/usr/bin/env bash
# Compile the solver module and independent student controller library.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
[[ ${WM_PROJECT_VERSION:-} == 13 ]] || { echo 'Source OpenFOAM Foundation 13 first.' >&2; exit 1; }
command -v wmake >/dev/null
wmake libso src/oxyControlFoam
wmake libso studentController
printf 'Built. Source scripts/activate.sh to expose the oxyControlFoam launcher.\n'
